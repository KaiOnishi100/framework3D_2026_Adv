//============================================================
// Bloom Bright Extraction
// HDRシーンから高輝度成分だけを抽出する
// 目的:
// ・懐中電灯で照らした通常の壁を白飛びさせにくくする
// ・炎やEmissiveなどの高輝度部分はBloomを残す
// ・Threshold付近の不自然な境界を抑える
//============================================================

Texture2D tex : register(t0);
SamplerState smp : register(s0);

struct PSInput
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_TARGET
{
    //========================================================
    // HDRシーンの色を取得
    //========================================================
    const float3 color = max(tex.Sample(smp, input.uv).rgb, 0.0f);

    //========================================================
    // RGBから輝度を計算
    // Max RGBではなくRec.709の輝度係数を使用
    //========================================================
    const float luminance = dot(color, float3(0.2126f, 0.7152f, 0.0722f));

    //========================================================
    // Bloom Threshold
    //========================================================
    const float threshold = 2.0f;

    //========================================================
    // Soft Knee
    // Threshold付近でBloomを滑らかに立ち上げる
    //========================================================
    const float knee = threshold * 0.5f;

    //========================================================
    // Soft Threshold計算
    //========================================================
    float soft = luminance - threshold + knee;

    soft = clamp(soft, 0.0f, 2.0f * knee);

    soft = soft * soft / max(4.0f * knee, 0.0001f);

    //========================================================
    // Thresholdを超える部分の抽出
    //========================================================
    const float hard = max(luminance - threshold, 0.0f);

    //========================================================
    // 抽出するBloom輝度
    //========================================================
    const float contribution = max(soft, hard);

    //========================================================
    // 輝度に応じて元のRGBを縮小する
    // 単純に元のHDR色を丸ごと加算しない
    // 色相を維持しながらBloom成分だけ抽出する
    //========================================================
    const float weight = contribution / max(luminance, 0.0001f);

    return float4(color * weight, 1.0f);
}