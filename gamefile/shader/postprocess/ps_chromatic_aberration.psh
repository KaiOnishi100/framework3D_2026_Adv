Texture2D sceneTex : register(t0);
SamplerState smp : register(s0);

//============================================================
// register(b0)
//   RootSignature の rp[1]
//   SetGraphicsRootConstantBufferView(1, address)
//   で渡している定数バッファ
//============================================================
cbuffer PostEffectParam : register(b0)
{
	//============================================================
	// ColorGrading
	//============================================================
    float brightness;
    float contrast;
    float saturation;
    float colorGradingPadding;

	//============================================================
	// Vignette
	//============================================================
    float vignetteStart;
    float vignetteEnd;
    float vignetteStrength;
    float vignettePadding;

	//============================================================
	// Chromatic Aberration
	//============================================================
    float chromaticStrength;
    float3 chromaticPadding;
};

struct PSInput
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
};

//============================================================
// 安全にUVを制限する
// ※画面端でUVが 0未満 / 1超え になると
// ※Sampler設定によっては反対側の画面を読んでしまう
// ※必ず 0.0 ～ 1.0 に収める
//============================================================
float2 ClampUV(float2 uv)
{
    return clamp(uv, float2(0.0f, 0.0f), float2(1.0f, 1.0f));
}

float4 main(PSInput input) : SV_TARGET
{
    float2 uv = input.uv;

	//============================================================
	// 画面中央からの方向
	// uv は 0.0 ～ 1.0 なので、中央は 0.5
	//============================================================
    float2 center = float2(0.5f, 0.5f);
    float2 dir = uv - center;

	//============================================================
	// 中央からの距離 画面端ほど値が大きくなる
	//============================================================
    float dist = length(dir);

	//============================================================
	// ※中央付近でnormalize(float2(0,0))すると不安定なので
	// ※距離がかなり小さい場合はズラさない
	//============================================================
    if (dist < 0.0001f)
    {
        return sceneTex.Sample(smp, uv);
    }

	//============================================================
	// 画面中央から外側へ向かう方向
	//============================================================
    float2 dirN = dir / dist;

	//============================================================
	// 色収差の強さ
	// 画面端ほどズレを強くするため dist を掛ける
	//============================================================
    float2 offset = dirN * dist * chromaticStrength;

	//============================================================
	// RGBを少し違う位置から読む
	// R : 外側
	// G : 元の位置
	// B : 内側
	//============================================================
    float r = sceneTex.Sample(smp, ClampUV(uv + offset)).r;
    float g = sceneTex.Sample(smp, uv).g;
    float b = sceneTex.Sample(smp, ClampUV(uv - offset)).b;

    return float4(r, g, b, 1.0f);
}