//============================================================
// HDR Scene
//============================================================
Texture2D txScene : register(t0);

//============================================================
// Bloom Texture
//============================================================
Texture2D txBloom : register(t1);

SamplerState samLinear : register(s0);

//============================================================
// Post Effect Parameter
//============================================================
cbuffer PostEffectParam : register(b0)
{
	// ColorGrading
    float4 ColorGradingParam;

	// Vignette
    float4 VignetteParam;

	// Chromatic Aberration
    float4 ChromaticParam;

	// x : Exposure
	// y : Bloom Intensity
	// z : Gamma
	// w : Bloom Enabled
    float4 ToneMappingParam;
};

struct pixelIn
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
};

//============================================================
// ACES Filmic近似
//============================================================
float3 ToneMapACES(float3 color)
{
    const float a =2.51f;
    const float b =0.03f;
    const float c =2.43f;
    const float d =0.59f;
    const float e =0.14f;
	
    return saturate((color * (a * color + b)) / (color * (c * color + d) + e));
}

float4 main(pixelIn IN) : SV_TARGET
{
	
	//============================================================
	// HDR Scene
	//============================================================
    float3 sceneColor =
		txScene.Sample(
			samLinear,
			IN.uv
		).rgb;

	//============================================================
	// Blur済みBloom
	//============================================================
    float3 bloomColor =
		txBloom.Sample(
			samLinear,
			IN.uv
		).rgb;

    const float exposure = ToneMappingParam.x;

    const float bloomIntensity = max(ToneMappingParam.y, 0.0f);

    const float gamma = max(ToneMappingParam.z, 0.001f);

    const float bloomEnabled = saturate(ToneMappingParam.w);

	//============================================================
	// HDR空間でBloomを加算
	//============================================================
    float3 hdrColor =
		sceneColor +
		bloomColor *
		bloomIntensity *
		bloomEnabled;

	//============================================================
	// Exposure
	// exposure =  0 : 1倍
	// exposure =  1 : 2倍
	// exposure = -1 : 0.5倍
	//============================================================
    hdrColor *= exp2(exposure);

	//============================================================
	// HDRからSDRへ圧縮
	//============================================================
    float3 mappedColor = ToneMapACES(hdrColor);

	//============================================================
	// BackBufferがR8G8B8A8_UNORMなのでShader側でGamma補正を行う
	//============================================================
    mappedColor = pow(max(mappedColor, 0.0f), 1.0f / gamma);

    return float4(mappedColor, 1.0f);
}