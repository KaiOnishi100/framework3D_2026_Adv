///---------------------------------
///横方向ガウス
///---------------------------------
Texture2D tex : register(t0);
SamplerState smp : register(s0);

struct PSInput
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_TARGET
{
    // Textureの実際のWidth / Height
    uint textureWidth = 0u;
    uint textureHeight = 0u;
    
    // Mip0の解像度を取得
    tex.GetDimensions(textureWidth, textureHeight);
    
	// 1/4解像度Bloom
    float2 texel = float2(max(textureWidth, 1u), max(textureHeight, 1u));

    float3 color = float3(0.0f, 0.0f, 0.0f);

	// 横方向だけぼかす
    color += tex.Sample(smp, input.uv + float2(-4.0f, 0.0f) * texel).rgb * 0.05f;
    color += tex.Sample(smp, input.uv + float2(-2.0f, 0.0f) * texel).rgb * 0.25f;
    color += tex.Sample(smp, input.uv).rgb * 0.40f;
    color += tex.Sample(smp, input.uv + float2(2.0f, 0.0f) * texel).rgb * 0.25f;
    color += tex.Sample(smp, input.uv + float2(4.0f, 0.0f) * texel).rgb * 0.05f;

    return float4(color, 1.0f);
}