///---------------------------------
///輝度抽出用シェーダー
///---------------------------------
Texture2D bloomTex : register(t0);
SamplerState smp : register(s0);

struct PSInput
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_TARGET
{
    float3 bloom = bloomTex.Sample(smp, input.uv).rgb;

	// Bloomの強さ
    bloom *= 1.2f;

    return float4(bloom, 0.5f);
}