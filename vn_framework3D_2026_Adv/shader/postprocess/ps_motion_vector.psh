//============================================================
// Camera Motion Vector生成
//
// Main Depth
//     ↓
// Current World Position復元
//     ↓
// Previous VPへ投影
//     ↓
// Current UV - Previous UV
//
// 出力: RG = Screen Space Velocity
//============================================================


//============================================================
// Main Depth
// R32_TYPELESS Resourceを
// R32_FLOAT SRVとして読む
//============================================================
Texture2D<float> txDepth : register(t0);


//============================================================
// Motion Vector Parameter
//============================================================
cbuffer MotionVectorBuffer : register(b0)
{
    //========================================================
    // Current ViewProjectionの逆行列
    //========================================================
    float4x4 InverseCurrentVP;

    //========================================================
    // Previous ViewProjection
    //========================================================
    float4x4 PreviousVP;
};


struct PixelInput
{
    float4 position : SV_POSITION;
    float2 uv : TEXCOORD0;
};


//============================================================
// Main
//============================================================
float2 main(PixelInput input) : SV_Target
{
    //========================================================
    // Depth
    //========================================================
    const float depth = txDepth.Load(int3(int2(input.position.xy), 0));


    //========================================================
    // Background
    // Depth == 1付近はGeometryが存在しない
    //========================================================
    if (depth >= 0.999999f)
    {
        return float2(0.0f, 0.0f);
    }


    //========================================================
    // UV → NDC
    // DirectX:
    // X:
    //   UV 0～1
    //      ↓
    //   NDC -1～1
    // Y:
    //   Textureは下向き+
    //   NDCは上向き+
    //========================================================
    const float2 currentNDC =
        float2(
            input.uv.x * 2.0f - 1.0f,
            1.0f - input.uv.y * 2.0f
        );


    //========================================================
    // Current Clip Position
    // DirectXのDepthは0～1なので
    // depthをそのままClip Zとして使用
    //========================================================
    float4 currentClip = float4(currentNDC, depth, 1.0f);


    //========================================================
    // Current Clip → World
    //========================================================
    float4 worldPosition = mul(currentClip, InverseCurrentVP);


    worldPosition /= max(abs(worldPosition.w), 0.000001f);


    //========================================================
    // World → Previous Clip
    //========================================================
    float4 previousClip = mul(worldPosition, PreviousVP);


    //========================================================
    // Camera後方など不正なProjectionを防ぐ
    //========================================================
    if (previousClip.w <= 0.000001f)
    {
        return float2(0.0f, 0.0f);
    }


    //========================================================
    // Previous Clip → Previous NDC
    //========================================================
    const float2 previousNDC =
        previousClip.xy / previousClip.w;


    //========================================================
    // Previous NDC → Previous UV
    //========================================================
    const float2 previousUV =
        float2(
            previousNDC.x * 0.5f + 0.5f,
            -previousNDC.y * 0.5f + 0.5f
        );


    //========================================================
    // Motion Vector
    // Current - Previous
    //========================================================
    float2 velocity =
        input.uv - previousUV;


    //========================================================
    // 異常な巨大Velocityを防止
    // Camera Teleport時はCPU側ResetHistory()も使用するが
    // Shader側でも最低限Clampしておく
    //========================================================
    velocity =
        clamp(
            velocity,
            float2(-1.0f, -1.0f),
            float2(1.0f, 1.0f)
        );


    return velocity;
}