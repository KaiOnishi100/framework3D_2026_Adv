Texture2D sceneTex : register(t0);
SamplerState smp : register(s0);

//============================================================
// register(b0)
//   RootSignature の rp[1]
//   SetGraphicsRootConstantBufferView(1, address)
//   で渡している定数バッファ
//============================================================
cbuffer PostEffectParam : register(b0)
{
	//============================================================
	// ColorGrading
	//============================================================
    float brightness;
    float contrast;
    float saturation;
    float colorGradingPadding;

	//============================================================
	// Vignette
	//============================================================
    float vignetteStart;
    float vignetteEnd;
    float vignetteStrength;
    float vignettePadding;

	//============================================================
	// Chromatic Aberration
	//============================================================
    float chromaticStrength;
    float3 chromaticPadding;
};

struct PSInput
{
    float4 pos : SV_POSITION;
    float2 uv : TEXCOORD0;
};

float4 main(PSInput input) : SV_TARGET
{
    float3 color = sceneTex.Sample(smp, input.uv).rgb;

    //============================================================
	// 画面中央からの距離
	//
	// uv は 0.0 ～ 1.0
	// 中央は 0.5, 0.5
	//============================================================
    float2 center = input.uv - float2(0.5f, 0.5f);
    float dist = length(center);
    
    #if 0
    //============================================================
    // 効果確認用：画面端がかなり暗くなる
    //============================================================
    float vignetteStart = 0.20f;
    float vignetteEnd = 0.70f;
    float strength = 0.85f;
    #endif
    
    #if 1
    
    //============================================================
    // vignetteStart    : 暗くなり始める距離
	// vignetteEnd      : 最大まで暗くなる距離
	// vignetteStrength : 暗さの強さ
	//============================================================
    float vignette = smoothstep(vignetteStart, vignetteEnd, dist);
    #endif

    color *= (1.0f - vignette * vignetteStrength);

    return float4(color, 1.0f);
}